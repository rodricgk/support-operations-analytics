table Fotografias
	lineageTag: 3407d497-8750-4ada-8545-150655cf0b12

	measure 'Fila Diaria' =
			
			VAR Dia = SELECTEDVALUE(Calendario[data])
			VAR DiaElegivel =
			    SELECTEDVALUE(Calendario[data_fotografia_elegivel], FALSE())
			RETURN
			    IF(
			        NOT ISBLANK(Dia) && DiaElegivel,
			        COALESCE(
			            CALCULATE(
			                COUNTROWS(Fotografias),
			                Fotografias[classe_estado] = "pendente"
			            ),
			            0
			        )
			    )
		formatString: 0
		lineageTag: d8b0efcd-fec8-4546-a9dd-18051753d92a

	measure 'Mediana Idade Fila Horas' =
			
			VAR Dia = SELECTEDVALUE(Calendario[data])
			VAR DiaElegivel =
			    SELECTEDVALUE(Calendario[data_fotografia_elegivel], FALSE())
			RETURN
			    IF(
			        NOT ISBLANK(Dia) && DiaElegivel,
			        CALCULATE(
			            MEDIAN(Fotografias[idade_horas]),
			            Fotografias[classe_estado] = "pendente",
			            Fotografias[idade_valida] = TRUE()
			        )
			    )
		lineageTag: d5130674-d8ad-4c5e-b8c0-1f0908fc56ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Referencia Fila' =
			
			CALCULATE(
			    MAX(Calendario[data]),
			    KEEPFILTERS(Calendario[data_fotografia_elegivel] = TRUE())
			)
		formatString: Short Date
		lineageTag: bafc1276-6c08-483e-be36-9aed193cd476

	measure 'Fila Fim do Periodo' =
			
			VAR Dia = [Data Referencia Fila]
			RETURN
			    IF(
			        NOT ISBLANK(Dia),
			        CALCULATE(
			            [Fila Diaria],
			            KEEPFILTERS(Calendario[data] = Dia)
			        )
			    )
		formatString: 0
		lineageTag: 260e0633-26eb-489d-886d-ad6303851247

	measure 'Mediana Idade Fim do Periodo Horas' =
			
			VAR Dia = [Data Referencia Fila]
			RETURN
			    IF(
			        NOT ISBLANK(Dia),
			        CALCULATE(
			            [Mediana Idade Fila Horas],
			            KEEPFILTERS(Calendario[data] = Dia)
			        )
			    )
		lineageTag: 89d80836-8034-4fa4-87f2-71c29ae4744d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

