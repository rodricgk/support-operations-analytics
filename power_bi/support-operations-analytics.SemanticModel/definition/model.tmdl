model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados","Calendario","Chamados","Fotografias","ResumoDiario"]

annotation PBI_ProTooling = ["DevMode"]

ref table Calendario
ref table Chamados
ref table Fotografias
ref table ResumoDiario

ref cultureInfo pt-BR

